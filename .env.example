# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Assinatura (exibição e cobrança usam o mesmo valor) ----------
# Preço mensal em centavos de real. 2990 = R$ 29,90
SUBSCRIPTION_PRICE_CENTS=2990
# Casos novos que cada conta pode gerar por mês de assinatura
GENERATION_LIMIT_PER_MONTH=30

# ---------- IA (um provedor) ----------
# anthropic | openai | mock   (mock = devolve variação do caso de demonstração, sem custo)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Para openai/compatível: https://api.openai.com/v1
AI_BASE_URL=
# Novas tentativas quando a validação falhar (custo máximo = 1 + este número)
AI_MAX_RETRIES=1

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://kdzucgfesisitpbfeccs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: use um Price existente. Se vazio, o Checkout cria o preço a partir de SUBSCRIPTION_PRICE_CENTS.
STRIPE_PRICE_ID=
# Produto já criado no Stripe; o preço mensal é criado a partir de SUBSCRIPTION_PRICE_CENTS
STRIPE_PRODUCT_ID=prod_Vgict4F6ZdRZBW

# ---------- Desenvolvimento ----------
# true = permite gerar casos sem login/assinatura (ignorado em produção)
ALIBI_DEV_UNLOCK=false

# ---------- Imagens por IA (opcional) ----------
# Ilustra a foto de abertura e as pistas fotográficas de cada caso novo (API compatível com OpenAI Images)
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium
IMAGE_MAX_PER_CASE=4
IMAGE_BASE_URL=
